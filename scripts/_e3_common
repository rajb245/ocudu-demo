# Shared by up_e3 / down_e3. Works against whichever cell is already running:
# the USRP cell (radio profile) or the ZMQ one. Never touches the cell itself.
demo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Base file ONLY - deliberately NOT the cuda overlay. These scripts act only on
# the gr-dapp / gr-dapp-usrp observer, which the overlay never touches. Passing
# the overlay made compose re-resolve the gnb dependency to ocudu-demo/gnb:cuda;
# on a CPU box that image does not exist, so "up_e3" fell through to a ~20-minute
# CUDA gNB build instead of just (re)starting the observer. up_e3 also runs
# up with --no-deps so the running cell is never recreated regardless of build.
COMPOSE_BASE="-f ${demo}/docker-compose.yml"

running() { [[ "$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" == true ]]; }

if running ocudu_demo_gnb_usrp; then
  GNB=ocudu_demo_gnb_usrp; DAPP=ocudu_demo_grdapp_usrp; SVC=gr-dapp-usrp; PROFILE=radio
elif running ocudu_demo_gnb; then
  GNB=ocudu_demo_gnb;      DAPP=ocudu_demo_grdapp;      SVC=gr-dapp;      PROFILE=zmq
else
  echo "no cell is running - start one with ./up" >&2
  exit 1
fi

CO=(docker compose $COMPOSE_BASE --profile "$PROFILE")
subs() { docker exec $GNB ocudu-dappctl inventory 2>/dev/null | grep -c '^  subscription'; }
det()  { docker logs $DAPP 2>/dev/null | grep -ac '"prb"'; }
