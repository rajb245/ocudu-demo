# Take the over-the-air UE off the air. The counterpart to scripts/up_ue.
set -euo pipefail
demo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec docker compose -f "${demo}/docker-compose.ue.yml" down "$@"
