## The name of THIS directory, as seen from the workspace root. The gNB and
## gr-dapp images build with the workspace as their context, so compose has to
## name this directory to find the Dockerfiles in it - and the public copy is
## staged as demo-public/. bootstrap.sh rewrites this to match wherever it is
## actually running, so you should not need to touch it.
DEMO_DIR=demo

## Which cell to run: zmq (virtual radio + OAI UE) or radio (USRP split 8).
## A CLI --profile replaces this rather than adding to it, so
## "--profile radio up -d" starts the USRP cell without the ZMQ pair.
COMPOSE_PROFILES=zmq

## Build
NUM_JOBS=10
OCUDU_BUILD_TYPE=Release
# Portable across modern x86-64 (AVX2). Use "native" for a host-local build.
OCUDU_MARCH=x86-64-v3

## gNB image variant
# Default: CPU L1. The CUDA overlay (docker-compose.cuda.yml) swaps these.
GNB_IMAGE=ocudu-demo/gnb:cpu
GNB_CUDA_IMAGE=ocudu-demo/gnb:cuda
GNB_BASE_IMAGE=ubuntu:24.04
GNB_ENABLE_CUDA=OFF
OCUDU_CUDA_IMAGE=nvidia/cuda:13.0.1-devel-ubuntu24.04
# Deployment GPU. 120-real = RTX 5090 (Blackwell, the demo target), 89-real =
# RTX 4090 / RTX 6000 Ada, 90-real = H100/GH200, 121 = GB10.
OCUDU_CUDA_ARCHITECTURES=120-real

## RAN network (10.53.1.0/24)
OPEN5GS_IP=10.53.1.2
GNB_IP=10.53.1.3
OAIUE_IP=10.53.1.4
GRDAPP_IP=10.53.1.6

## OAI nrUE with a real radio (docker-compose.ue.yml, separate host)
# Pin the device so a second USRP on the same bus cannot be picked up.
# Set this to YOUR B200mini's serial: uhd_find_devices
UE_USRP_ARGS=type=b200,serial=CHANGEME
# CAUTION: these are NOT UHD gains. OAI subtracts a per-device calibration
# offset before handing the value to UHD, and prints it at startup:
#
#   RX Gain 0 95.000000 (45.250000) => 49.750000 (max 76.000000)
#   USRP TX_GAIN:19.75 gain_range:89.75 tx_gain:70.00
#
# So on this B200mini the RX offset is 45.25 dB: --ue-rxgain 76 is only UHD
# 30.75, and 50 is UHD 4.75 (too low to sync at all). Anything measured with a
# bare UHD capture is on the other scale - do not carry numbers across.
#
# 95 -> UHD 49.75, which is where a direct capture of the gNB's SSB is strong
# and unsaturated. The B200mini rails at UHD ~60+ (|I|,|Q| <= 1.0, so magnitude
# 1.41 = both at full scale).
UE_RX_GAIN=95
# TX is worse: on a B2xx OAI treats --ue-txgain as an ATTENUATION from maximum,
#   applied UHD gain = 89.75 - value      ("USRP TX_GAIN:19.75 ... tx_gain:70.00")
# so 70 was only 19.75 dB of drive and 110 clamped to zero. Every earlier TX
# "sweep" (50->80) was 40->10 dB of UHD gain, going the wrong way. 10 -> UHD
# 79.75, and the gNB detected the real preamble immediately.
UE_TX_GAIN=10
# Deliberately NOT called UHD_IMAGES_DIR: that is UHD's own variable and is
# already exported system-wide by a host UHD install. Compose prefers the shell
# environment over this file, so the host's value would win and mount the
# host's (version-mismatched) images into the container.
# ${HOME} is interpolated by compose; a literal ~ would not be.
UE_UHD_IMAGES_DIR=${HOME}/uhd-images

## OAI nrUE source
# Pinned to the commit the demo was brought up and measured against, not to
# develop: that branch merges an integration branch most weeks, and an
# attendee should build the UE we ran. Compose hands this to BuildKit as
# ${OAIUE_REPO}#${OAIUE_BRANCH}, which takes a branch name or a FULL commit
# sha (a short sha is rejected). To move it: set a new sha, rebuild oaiue
# and oaiue-usrp, and re-check that patches/oai/ still applies (the
# Dockerfile greps for the result, so a failure is loud).
OAIUE_REPO=https://github.com/duranta-project/openairinterface5g.git
OAIUE_BRANCH=3313a9b943c187d4ed42fdf314da4f8483722dc5

## Metrics UI. These are the values compose substitutes into
## docker-compose.yml; the container-side environment is metrics.env, and the
## few names that appear in both must agree.
INFLUXDB3_VERSION=3.1.0-core
INFLUXDB3_PORT=8081
INFLUXDB3_HTTP_BIND_ADDR=0.0.0.0:8081
INFLUXDB3_HOST_URL=http://127.0.0.1:8081
INFLUXDB3_LOG_LEVEL=error
GF_VERSION=13.0.2
GF_PORT=3000
