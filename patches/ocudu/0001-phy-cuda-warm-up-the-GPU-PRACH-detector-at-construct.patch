+
+void prach_detector_cuda_impl::warm_up(const warmup_configuration& warmup)
+{
+  if (!gpu_available || (handle == nullptr) || (stream == nullptr)) {
+    return;
+  }
+  if (!env_flag_enabled("OCUDU_PRACH_ACCELERATION_WARMUP", true)) {
+    return;
+  }
+  ocudulog::basic_logger& logger = ocudulog::fetch_basic_logger("PHY");
+
+  // A representative configuration for the cell: format 0 (long) or B4 (short), all 64 preambles, unrestricted
+  // set, root 0. Root sequences differ from the live cell's, so the first live detection re-uploads roots and
+  // captures a new graph (microseconds); the IDFT plan, buffers and kernels are keyed by geometry and are reused.
+  configuration config        = {};
+  config.root_sequence_index  = 0;
+  config.format               = warmup.long_format ? prach_format_type::zero : prach_format_type::B4;
+  config.restricted_set       = restricted_set_config::UNRESTRICTED;
+  config.zero_correlation_zone = env_unsigned("OCUDU_PRACH_WARMUP_ZCZ", warmup.zero_correlation_zone);
+  config.start_preamble_index = 0;
+  config.nof_preamble_indices = prach_constants::MAX_NUM_PREAMBLES;
+  config.ra_scs               = warmup.long_format ? prach_subcarrier_spacing::kHz1_25 : prach_subcarrier_spacing::kHz30;
+  config.nof_rx_ports         = std::max(1U, warmup.nof_rx_ports);
+  config.slot                 = slot_point();
+
+  if (prach_cyclic_shifts_get(config.ra_scs, config.restricted_set, config.zero_correlation_zone) ==
+      PRACH_CYCLIC_SHIFTS_RESERVED) {
+    logger.warning("CUDA: PRACH detector warm-up skipped, zero correlation zone {} is reserved for this format.",
+                   config.zero_correlation_zone);
+    return;
+  }
+
+  const auto              t0       = std::chrono::steady_clock::now();
+  const detector_geometry geometry = compute_geometry(config);
+
+  std::lock_guard<std::mutex> lock(detector_mutex);
+  prepare_roots(config, geometry);
+
+  // Zeroed host input of the live shape: ports x symbols x sequence length, one cbf16 per word.
+  host_prach_packed.assign(static_cast<size_t>(config.nof_rx_ports) * geometry.nof_symbols * geometry.sequence_length,
+                           0U);
+  prach_detector_config_t cuda_config = make_cuda_config(config, geometry);
+  cuda_config.input_is_device         = 0;
+  cuda_config.input_symbol_stride     = static_cast<int>(geometry.sequence_length);
+  cuda_config.input_port_stride       = static_cast<int>(geometry.nof_symbols * geometry.sequence_length);
+
+  const cf_t* active_roots =
+      host_roots.data() + static_cast<size_t>(geometry.active_sequence_start) * geometry.sequence_length;
+  prach_detector_result_t cuda_result = {};
+  nr_ldpc_status_t        status =
+      prach_detector_detect(handle, host_prach_packed.data(), active_roots, &cuda_config, &cuda_result, stream);
+
+  const double elapsed_ms =
+      std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+  if (!is_success(status)) {
+    logger.warning("CUDA: PRACH detector warm-up failed (status {}) after {:.1f} ms; the first live detection will "
+                   "build the plan instead.",
+                   static_cast<int>(status),
+                   elapsed_ms);
+    return;
+  }
+  logger.info("CUDA: PRACH detector warmed up for {} preamble format, {} rx port(s), zcz {} in {:.1f} ms "
+              "(IDFT {} x {} batches).",
+              warmup.long_format ? "long" : "short",
+              config.nof_rx_ports,
+              config.zero_correlation_zone,
+              elapsed_ms,
+              geometry.dft_size,
+              config.nof_rx_ports * (geometry.combine_symbols ? 1U : geometry.nof_symbols) * geometry.active_nof_sequences);
 }
 
