+// Compiled-kernel cache for the VkFFT IDFT plan.
+//
+// initializeVkFFT() compiles the kernel with NVRTC: 15-55 ms on an RTX 5090, measured on the first PRACH
+// detection of every pooled detector instance, on a shared worker that also carries the DU slot chain. The
+// constructor-time warm-up in prach_detector_cuda_impl takes it off the slot path; this cache takes it off the
+// start-up path from the second process start on. The image is keyed by everything that changes the binary:
+// VkFFT version, CUDA runtime, device compute capability, DFT size, batch and thread aim. A stale or corrupt
+// image only costs one recompile (initializeVkFFT fails, we retry without it and overwrite).
+// Directory: OCUDU_PRACH_VKFFT_CACHE_DIR (default /tmp/ocudu-prach-vkfft; "0"/"off" disables).
+std::string vkfft_cache_path(int dft_size, int batch, int aim_threads)
+{
+    const char* env = std::getenv("OCUDU_PRACH_VKFFT_CACHE_DIR");
+    std::string dir = (env != nullptr) ? env : "/tmp/ocudu-prach-vkfft";
+    if (dir.empty() || dir == "0" || dir == "off" || dir == "false") {
+        return {};
+    }
+    int device = 0;
+    cudaDeviceProp prop{};
+    if (cudaGetDevice(&device) != cudaSuccess || cudaGetDeviceProperties(&prop, device) != cudaSuccess) {
+        return {};
+    }
+    ::mkdir(dir.c_str(), 0755); // EEXIST is fine; any other failure surfaces as an unreadable/unwritable file below
+    char name[160];
+    std::snprintf(name, sizeof(name), "/prach_idft_vk%d_rt%d_cc%d%d_d%d_b%d_t%d.bin", VkFFTGetVersion(),
+                  CUDART_VERSION, prop.major, prop.minor, dft_size, batch, aim_threads);
+    return dir + name;
+}
+
+bool read_cache_file(const std::string& path, std::vector<char>& blob)
+{
+    std::ifstream in(path, std::ios::binary);
+    if (!in) {
+        return false;
+    }
+    blob.assign(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+    return !blob.empty();
+}
+
+void write_cache_file(const std::string& path, const void* data, size_t size)
+{
+    if (data == nullptr || size == 0) {
+        return;
+    }
+    const std::string tmp = path + ".tmp";
+    {
+        std::ofstream out(tmp, std::ios::binary | std::ios::trunc);
+        if (!out) {
+            return;
+        }
+        out.write(static_cast<const char*>(data), static_cast<std::streamsize>(size));
+        if (!out) {
+            std::remove(tmp.c_str());
+            return;
+        }
+    }
+    if (std::rename(tmp.c_str(), path.c_str()) != 0) {
+        std::remove(tmp.c_str());
+    }
+}
+
 bool ensure_plan(prach_detector_ctx* ctx, int dft_size, int batch, cudaStream_t stream)
 {
     if (ctx->vkfft_valid && ctx->vkfft_dft_size == dft_size && ctx->vkfft_batch == batch &&
@@ -599,10 +666,32 @@ bool ensure_plan(prach_detector_ctx* ctx, int dft_size, int batch, cudaStream_t
     // Larger DFTs (format-0, 1024) benefit from more threads on GB10-class GPUs.
     configuration.aimThreads = (dft_size >= 512) ? 256 : 128;
 
-    if (initializeVkFFT(&ctx->vkfft_app, configuration) != VKFFT_SUCCESS) {
+    const std::string cache_path = vkfft_cache_path(dft_size, batch, static_cast<int>(configuration.aimThreads));
+    std::vector<char>  cache_blob;
+    if (!cache_path.empty() && read_cache_file(cache_path, cache_blob)) {
+        configuration.loadApplicationFromString = 1;
+        configuration.loadApplicationString     = cache_blob.data();
+    } else if (!cache_path.empty()) {
+        configuration.saveApplicationToString = 1;
+    }
+    VkFFTResult init_result = initializeVkFFT(&ctx->vkfft_app, configuration);
+    if ((init_result != VKFFT_SUCCESS) && (configuration.loadApplicationFromString != 0)) {
+        // Stale or corrupt cache image: compile as if it were not there, and replace it.
+        std::memset(&ctx->vkfft_app, 0, sizeof(ctx->vkfft_app));
+        cache_blob.clear();
+        configuration.loadApplicationFromString = 0;
+        configuration.loadApplicationString     = nullptr;
+        configuration.saveApplicationToString   = 1;
+        init_result                             = initializeVkFFT(&ctx->vkfft_app, configuration);
+    }
+    if (init_result != VKFFT_SUCCESS) {
         std::memset(&ctx->vkfft_app, 0, sizeof(ctx->vkfft_app));
         return false;
     }
+    if ((configuration.saveApplicationToString != 0) && !cache_path.empty()) {
+        write_cache_file(cache_path, ctx->vkfft_app.saveApplicationString, ctx->vkfft_app.applicationStringSize);
+    }
+    ctx->vkfft_cache_blob = std::move(cache_blob);
     ctx->vkfft_dft_size = dft_size;
     ctx->vkfft_batch = batch;
     ctx->vkfft_valid = true;
