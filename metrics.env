#
# Container environment for the metrics UI (telegraf, InfluxDB, Grafana).
#
# This is an env_file: it is injected into those containers. It is NOT the
# compose variable file - the ${...} substitutions in docker-compose.yml come
# from .env, and the few values that appear in both are noted there.
#
# Derived from the public platform's docker/.env (ocudu/docker/.env), which is
# what telegraf.conf and the Grafana datasource are written against. Two values
# are ours: WS_URL, because the gNB's metrics websocket is on the demo's own
# network, and GNB_ID, which tags every point.

## Telegraf
# The gNB's metrics websocket. The gnb service joins the `metrics` bridge at
# 172.19.1.3 precisely so telegraf can reach it without crossing `ran`.
WS_URL=172.19.1.3:8001
GNB_ID=ocudu-demo

TELEGRAF_VERSION=1.35.0
TELEGRAF_INPUT_INTERVAL=1s
TELEGRAF_OUTPUT_INTERVAL=1s
TELEGRAF_BUFFER_LIMIT=10000

## InfluxDB
INFLUXDB3_VERSION=3.1.0-core
INFLUXDB3_PORT=8081
INFLUXDB3_HTTP_BIND_ADDR=0.0.0.0:$INFLUXDB3_PORT
INFLUXDB3_HOST_URL=http://127.0.0.1:$INFLUXDB3_PORT
INFLUXDB3_EXTERNAL_URL=http://influxdb:${INFLUXDB3_PORT}
INFLUXDB3_AUTH_TOKEN=fake-token-1234567890abcdef
INFLUXDB3_BUCKET=ocudu
INFLUXDB3_TESTBED=default
INFLUXDB3_LOG_LEVEL=error
INFLUXDB3_RATE_LIMIT=0
INFLUXDB3_RATE_LIMIT_PERIOD=0s
INFLUXDB3_AUTH_TOKEN_FILE=/run/secrets/token

## Grafana
GF_VERSION=13.0.2
GF_PORT=3000
GF_AUTH_ANONYMOUS_ENABLED=true
GF_LOG_LEVEL=warning
GF_DASHBOARDS_MIN_REFRESH_INTERVAL=1s
GF_PLUGINS_PLUGIN_ADMIN_ENABLED=false
